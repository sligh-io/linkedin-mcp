{
  "name": "linkedin-mcp",
  "version": "0.2.1",
  "description": "Open-source MCP server for the official LinkedIn API \u2014 automate posts on your personal profile from Claude, ChatGPT, Cursor and any MCP client.",
  "type": "module",
  "bin": {
    "linkedin-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "auth": "node dist/index.js auth",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "linkedin",
    "claude",
    "chatgpt",
    "openai",
    "ai",
    "llm"
  ],
  "author": "Andreas Henkel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sligh-io/linkedin-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sligh-io/linkedin-mcp/issues"
  },
  "homepage": "https://github.com/sligh-io/linkedin-mcp#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "5.9.3"
  }
}
